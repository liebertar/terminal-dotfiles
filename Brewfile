# Brewfile — terminal-dotfiles
# Run: brew bundle --file=./Brewfile
# Idempotent: re-running skips already-installed items.

# --- Taps ---
tap "homebrew/bundle"

# --- Terminal & multiplexer ---
cask "ghostty"
brew "tmux"

# --- Fonts (config requires both) ---
cask "font-jetbrains-mono"
cask "font-d2coding"

# --- zsh plugins (sourced by .zshrc) ---
brew "zsh-syntax-highlighting"
brew "zsh-autosuggestions"

# --- Core CLI ---
brew "git"
brew "gh"
brew "coreutils"

# --- Python toolchain (referenced by .zprofile / .zshrc) ---
brew "pyenv"
